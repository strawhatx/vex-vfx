# Google Apps Script web app /exec URL that appends rows to the waitlist sheet (required)
GOOGLE_SHEETS_WEBHOOK_URL=
# Shared secret checked by the Apps Script (optional)
WAITLIST_SECRET=
# Project name sent with each row (optional, defaults to "flarecut")
WAITLIST_PROJECT=flarecut
# Comma-separated sheet column headers (optional, defaults to Timestamp,Email,Source)
WAITLIST_HEADERS=
